# 모두 선택 항목입니다. 없어도 앱은 동작합니다.

# AI 근거 제안을 Claude로 받으려면 설정 (없으면 규칙 엔진 근거를 보여줌)
ANTHROPIC_API_KEY=
# 기본값 claude-opus-5-5
CLAUDE_MODEL=

# 담당자 결정을 영구 저장하려면 Neon 등 Postgres 연결 문자열 (없으면 메모리+브라우저 저장)
# 테이블은 앱이 첫 연결 때 자동으로 만듭니다(db/schema.sql 과 같은 내용).
DATABASE_URL=

# [인증] Supabase Auth — Vercel Supabase 연동(접두어 SUPA)이 자동으로 넣어 줍니다.
#   서버: SUPA_SUPABASE_URL, SUPA_SUPABASE_ANON_KEY
#   브라우저: SUPA_VITE_SUPABASE_URL, SUPA_VITE_SUPABASE_ANON_KEY (vite envPrefix 로 노출)
# 로컬에서 로그인까지 테스트하려면 위 값을 채우세요. 비우면 로그인 없이 '검토자 이름' 입력 방식으로 동작합니다.
# 결정 권한을 제한하려면(선택): 쉼표로 구분
AUDITOR_EMAILS=
AUDITOR_EMAIL_DOMAINS=

# [인증] 데모 토큰 서명 키 (선택). 없으면 Supabase 서버 비밀 키에서 파생, 그것도 없으면 프로세스마다 새로 만듭니다.
DEMO_TOKEN_SECRET=
# 이메일 계정의 부서 지정 (선택, 기본 QI): 메일=QI|NURSING|EM|BED, 쉼표 구분
DEPT_ASSIGNMENTS=
